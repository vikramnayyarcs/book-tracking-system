{
  "name": "book-tracking-system",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core/tsconfig.json && tsc -p packages/api-contract/tsconfig.json && tsc -p test/e2e/tsconfig.json && tsc -p test/api/tsconfig.json",
    "test": "vitest run",
    "contract:check": "npm run check -w packages/api-contract",
    "test:e2e": "playwright test",
    "prepare": "simple-git-hooks",
    "pr-video": "node scripts/pr-video/download.ts",
    "test:api": "vitest run --config vitest.api.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@interfere/landmines": "0.1.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "msw": "3.0.7",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "simple-git-hooks": "2.14.0",
    "supabase": "3.2.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/git-hooks/pre-commit.ts"
  }
}

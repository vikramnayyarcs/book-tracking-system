{
  "name": "book-tracking-system",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/core/tsconfig.json",
    "test": "vitest run",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@interfere/landmines": "0.1.1",
    "@types/node": "24.19.2",
    "oxlint": "1.94.0",
    "prettier": "3.10.1",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/git-hooks/pre-commit.ts"
  }
}

meta {
  name: Create push subscription
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/push-subscriptions
  body: json
  auth: inherit
}

headers {
  x-gateway-secret: {{process.env.BT_GATEWAY_SECRET}}
}

body:json {
  {
    "endpoint": "https://fcm.googleapis.com/fcm/send/sample-device",
    "keys": {
      "p256dh": "invented-p256dh-key",
      "auth": "invented-auth-secret"
    }
  }
}

docs {
  operationId: createPushSubscription
}

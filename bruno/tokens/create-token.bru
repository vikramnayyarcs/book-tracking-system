meta {
  name: Create token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/tokens
  body: json
  auth: inherit
}

headers {
  x-gateway-secret: {{process.env.BT_GATEWAY_SECRET}}
}

body:json {
  {
    "name": "Sample Shortcut",
    "scopes": ["sessions:write", "books:read"]
  }
}

docs {
  operationId: createToken
}

script:post-response {
  bru.setVar("tokenId", res.body.id);
}

meta {
  name: Create finish photo upload
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/books/{{bookId}}/finish-photo
  body: json
  auth: inherit
}

headers {
  x-gateway-secret: {{process.env.BT_GATEWAY_SECRET}}
}

body:json {
  {
    "extension": "jpg"
  }
}

docs {
  operationId: createFinishPhotoUpload
}

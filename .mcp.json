{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "terraform": {
      "type": "stdio",
      "command": "terraform-mcp-server",
      "args": ["stdio"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${BT_GITHUB_MCP_TOKEN:-}",
        "X-MCP-Readonly": "true"
      }
    }
  }
}
